# Default configuration for Katalon Knowledge Agent
# Override these by creating a .env file (gitignored)

# Server Configuration
HOST=0.0.0.0
PORT=8006

# Agent Configuration
AGENT_NAME=katalon_exploration_agent
MODEL_NAME=bedrock/us.anthropic.claude-3-5-sonnet-20241022-v2:0

# MCP Server Configuration
MCP_PUBLIC_SERVER_URL=https://mcp.qa.katalon.com/mcp


# Logging Configuration
LOG_LEVEL=INFO

# AWS / Bedrock KB Configuration
AWS_REGION=ap-southeast-1
KB_ID=
RETRIEVAL_TOPK=8
NEXTSTEP_MIN_W=0.6
GRAPH_FILE=artifacts/neighbors.jsonl
