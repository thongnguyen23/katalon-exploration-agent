# Example configuration for Katalon Knowledge Agent
# Copy to .env and adjust values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8006

# Agent Configuration
AGENT_NAME=katalon_knowledge_agent
MODEL_NAME=gemini-2.5-flash

# Google API Configuration (REQUIRED)
GOOGLE_API_KEY=your_google_api_key_here

# MCP Server Configuration (REQUIRED)
MCP_PUBLIC_SERVER_URL=https://mcp.qa.katalon.com/mcp

# A2A Configuration
A2A_AGENT_DESCRIPTION=An agent that provides information about Katalon products.
A2A_AGENT_VERSION=1.0.0

# Logging Configuration
LOG_LEVEL=INFO

# AWS / Bedrock KB Configuration
AWS_REGION=ap-southeast-1
KB_ID=kb-xxxxxxxxxxxxxxx
RETRIEVAL_TOPK=8
NEXTSTEP_MIN_W=0.6
GRAPH_FILE=artifacts/neighbors.jsonl
